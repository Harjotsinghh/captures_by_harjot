    "lenis": "^1.3.21",
    "lightgallery": "^2.9.0",
    "lottie-react": "^2.4.1",
    "lucide-react": "^0.545.0",
    "maplibre-gl": "^4.7.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-ga4": "^2.1.0",
    "react-icons": "^5.5.0",
    "react-leaflet": "^5.0.0",
    "react-modal": "^3.16.3",
    "react-modal-sheet": "^5.2.1",
