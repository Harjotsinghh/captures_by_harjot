    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^16.4.0",
    "rollup-plugin-visualizer": "^7.0.1",
    "typescript": "~5.9.3",
