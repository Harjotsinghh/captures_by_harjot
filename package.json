  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "preinstall": "node -e \"const p=JSON.parse(require('fs').readFileSync('package.json')); if(p.dependencies?.axios || p.devDependencies?.axios) { console.error('ERROR: axios is forbidden for security. Use fetch instead.'); process.exit(1) }\"",
    "check-axios": "npm ls axios || echo 'PASS: axios not found in dependency tree'"
  },
